{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodekeeper",
  "version": "0.1.0",
  "identifier": "com.nodekeeper.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nodekeeper",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "script-src": "'self'",
        "frame-src": "http://127.0.0.1:8080 http://127.0.0.1:8081 http://127.0.0.1:8082 http://127.0.0.1:8083"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
